# SQLite for local workshop. Swap to Postgres by changing the provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Site origin ONLY — do NOT put /api/auth/callback/google here (Auth.js appends that).
AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# In Google Console → Authorized redirect URIs, add exactly:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Extra admin emails (comma-separated). etienne.landman@vulcanlabs.com is always admin.
# ADMIN_EMAILS="other@example.com"
